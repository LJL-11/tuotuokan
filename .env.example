# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，绝不提交）
# 供应商：阿里云百炼 OpenAI 兼容模式；Node 20.6+ 用 node --env-file=.env services/api/server.js 启动
TTK_LLM_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
TTK_LLM_API_KEY=
TTK_LLM_MODEL=deepseek-v4.1-flash-1017
# 混合推理模型必须关闭思考阶段，否则完整模板生成可达 30 秒（远超 7 秒服务端超时）
TTK_LLM_THINKING=off
# 可选：总超时毫秒（1-7000，需早于客户端 8 秒期限）
# TTK_LLM_TIMEOUT_MS=7000
